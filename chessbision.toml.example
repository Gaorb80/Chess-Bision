# Chép thành chessbision.toml (cùng thư mục chạy lệnh) để cả CLB dùng chung một kiểu phiếu.
# Tham số dòng lệnh ghi đè các giá trị ở đây.
[phieu]
bien_soan = "CLB Dream Chess"
cap_do = ""          # A / B / C … in cạnh tiêu đề
tieu_de = ""         # trống: lấy tên study
ky_hieu = "quoc-te"  # quoc-te: Ra8#  |  vi: Xa8#
bo_cuc = "2x3"       # 2x2 | 2x3 | 3x3 (có tọa độ) | 3x4 (12 thế, không tọa độ)
dap_an = "cung"      # cung: trang cuối phieu.pdf | rieng: dap-an.pdf | khong
diem = false         # in ô điểm từng bài trên phiếu học sinh
huong = "ben-di"     # ben-di: bên phải đi ở dưới | trang: luôn Trắng dưới
bo_trung = true      # bỏ bài trùng thế cờ
le_gay = "trai"      # trai: chừa 25 mm bên trái | guong: in hai mặt, 25 mm phía gáy | khong: 18 mm hai bên
bai_chua_dap_an = false  # in cả bài chưa có nước đáp án
